<shared:HudPageBase x:Class="SableHUD.Widgets.AudioView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:shared="clr-namespace:SableHUD.Shared"
                     xmlns:controls="clr-namespace:SableHUD.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="10" />
            <RowDefinition Height="36" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:HudButton x:Name="MasterButton"
                            Height="76" CornerRadius="19" Padding="20,0"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource Stroke}"
                            BorderThickness="1"
                            HorizontalContentAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="System volume" Style="{StaticResource Micro}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="MasterValue" Style="{StaticResource StatValue}" FontSize="28" Text="—" />
                        <TextBlock Text="%" Style="{StaticResource Dim}" Margin="4,10,0,0" />
                        <TextBlock x:Name="MasterState" Style="{StaticResource Dim}" Margin="10,10,0,0" Text="live" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4,24,0">
                    <controls:HudProgress x:Name="MasterBar" Height="6"
                                          Track="{DynamicResource StrokeStrong}"
                                          Fill="{DynamicResource Text}" />
                    <TextBlock x:Name="MasterHint" Text="A mutes · ◀ ▶ volume" Style="{StaticResource Dim}" Margin="0,8,0,0" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Path x:Name="MasterIcon" Grid.Column="2"
                      Data="{StaticResource IconVolume}"
                      Fill="{DynamicResource Text}"
                      Width="22" Height="22" Stretch="Uniform"
                      HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </controls:HudButton>

        <Grid Grid.Row="2">
            <TextBlock Text="App mixer" Style="{StaticResource Micro}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <controls:HudButton x:Name="OutputButton"
                                    Height="36" CornerRadius="10" Padding="12,0" Margin="0,0,8,0"
                                    Background="{DynamicResource BgSoft}"
                                    BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                    Icon="{StaticResource IconVolume}" IconSize="15" IconMargin="0,0,8,0"
                                    Content="Output" FontSize="13" />
                <controls:HudButton x:Name="MicButton"
                                    Height="36" CornerRadius="10" Padding="12,0"
                                    Background="{DynamicResource BgSoft}"
                                    BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                    Icon="{StaticResource IconMic}" IconSize="15" IconMargin="0,0,8,0"
                                    Content="Mic live" FontSize="13" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="10,8">
            <Grid>
                <StackPanel x:Name="SessionRows" />
                <TextBlock x:Name="NoSessions"
                           Style="{StaticResource Body}"
                           Text="No apps are playing audio"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</shared:HudPageBase>
