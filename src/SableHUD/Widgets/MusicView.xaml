<shared:HudPageBase x:Class="SableHUD.Widgets.MusicView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:shared="clr-namespace:SableHUD.Shared"
                     xmlns:controls="clr-namespace:SableHUD.Controls">

    <Grid>
        <!-- ============================ now playing ============================ -->
        <Grid x:Name="NowPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="164" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="258" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ArtFrame"
                    Width="164" Height="164"
                    VerticalAlignment="Top"
                    CornerRadius="22"
                    BorderBrush="{DynamicResource Stroke}"
                    BorderThickness="1"
                    Background="{DynamicResource BgSoft}">
                <Grid>
                    <Border CornerRadius="21">
                        <Border.Background>
                            <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>
                    <Grid x:Name="ArtFallback">
                        <Grid.Background>
                            <RadialGradientBrush Center="0.3,0.2" GradientOrigin="0.25,0.15" RadiusX="1.1" RadiusY="1.1">
                                <GradientStop Color="{DynamicResource ArtTint}" Offset="0" />
                                <GradientStop Color="{DynamicResource ArtShade}" Offset="1" />
                            </RadialGradientBrush>
                        </Grid.Background>
                        <Path Data="{StaticResource IconMusic}"
                              Fill="{DynamicResource TextDim}"
                              Width="46" Height="46"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Opacity="0.85" />
                    </Grid>
                    <Border VerticalAlignment="Bottom" Height="58" CornerRadius="0,0,21,21" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#33000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource BgSoft}"
                            BorderBrush="{DynamicResource Stroke}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Height="23"
                            Padding="9,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="SourceDot" Width="5" Height="5" Fill="{DynamicResource Text}" VerticalAlignment="Center" />
                            <TextBlock x:Name="SourceText" Style="{StaticResource Micro}" Margin="7,1,0,0" Text="Media" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StateText" Style="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center" Text="Idle" />
                </StackPanel>

                <TextBlock x:Name="TrackTitle" Style="{StaticResource Display}" Margin="0,11,0,0" Text="Silence" />
                <TextBlock x:Name="TrackArtist" Style="{StaticResource Body}" FontSize="15" Margin="0,3,0,0" Text="Nothing is playing yet" />
                <TextBlock x:Name="TrackAlbum" Style="{StaticResource Dim}" Margin="0,4,0,0" Text="" />

                <Grid x:Name="SeekHit" Height="17" Margin="0,16,0,0" Background="Transparent" Cursor="Hand">
                    <controls:HudProgress x:Name="SeekBar"
                                          Height="3"
                                          VerticalAlignment="Center"
                                          Track="{DynamicResource StrokeStrong}"
                                          Fill="{DynamicResource Text}" />
                </Grid>
                <Grid Margin="0,2,0,0">
                    <TextBlock x:Name="ElapsedText" Style="{StaticResource Dim}" HorizontalAlignment="Left" Text="0:00" />
                    <TextBlock x:Name="DurationText" Style="{StaticResource Dim}" HorizontalAlignment="Right" Text="0:00" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                    <controls:HudButton x:Name="PlayButton"
                                        Width="56" Height="56"
                                        CornerRadius="28"
                                        Solid="True"
                                        Background="{DynamicResource Accent}"
                                        Foreground="{DynamicResource OnAccent}"
                                        IconSize="21" IconMargin="0" Padding="0"
                                        Icon="{StaticResource IconPlay}" />
                    <controls:HudButton x:Name="PrevButton"
                                        Width="40" Height="40" Margin="14,8,0,0"
                                        CornerRadius="20"
                                        Icon="{StaticResource IconPrev}" IconSize="16" IconMargin="0" Padding="0"
                                        ToolTip="Previous (LB / RB switches widgets)" />
                    <controls:HudButton x:Name="NextButton"
                                        Width="40" Height="40" Margin="8,8,0,0"
                                        CornerRadius="20"
                                        Icon="{StaticResource IconNext}" IconSize="16" IconMargin="0" Padding="0" />
                    <Border Width="1" Height="22" Background="{DynamicResource Stroke}" Margin="16,17,0,0" />
                    <controls:HudButton x:Name="ShuffleButton"
                                        Width="34" Height="34" Margin="14,11,0,0"
                                        CornerRadius="11"
                                        Icon="{StaticResource IconShuffle}" IconSize="15" IconMargin="0" Padding="0"
                                        ToolTip="Shuffle local library" />
                    <controls:HudButton x:Name="RepeatButton"
                                        Width="34" Height="34" Margin="6,11,0,0"
                                        CornerRadius="11"
                                        Icon="{StaticResource IconRepeat}" IconSize="15" IconMargin="0" Padding="0"
                                        ToolTip="Repeat local library" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,14" VerticalAlignment="Top" Height="252">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Source" Style="{StaticResource Micro}" />
                    <TextBlock x:Name="SideSource" Grid.Row="1" Style="{StaticResource Heading}" FontSize="20" Margin="0,5,0,0" Text="—" />
                    <Border Grid.Row="2" Style="{StaticResource Divider}" Margin="0,12,0,0" />
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock x:Name="SideLabel" Text="Next up" Style="{StaticResource Micro}" />
                        <TextBlock x:Name="SideDetail" Style="{StaticResource Body}" FontSize="13" Margin="0,5,0,0" Text="Start a track to see more." TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="5">
                        <controls:HudButton x:Name="OpenMusicButton"
                                            Height="34" CornerRadius="11" Padding="10,0"
                                            HorizontalContentAlignment="Left"
                                            Icon="{StaticResource IconLibrary}" IconSize="15" IconMargin="0,0,8,0"
                                            Content="Browse LiMusic" FontSize="13" />
                        <controls:HudButton x:Name="LibraryButton"
                                            Height="34" CornerRadius="11" Margin="0,6,0,0" Padding="10,0"
                                            HorizontalContentAlignment="Left"
                                            Icon="{StaticResource IconSearch}" IconSize="15" IconMargin="0,0,8,0"
                                            Content="Search" FontSize="13" />
                        <controls:HudButton x:Name="MiniButton" Visibility="Collapsed"
                                            Height="34" CornerRadius="11" Margin="0,6,0,0" Padding="10,0"
                                            HorizontalContentAlignment="Left"
                                            Icon="{StaticResource IconMonitor}" IconSize="15" IconMargin="0,0,8,0"
                                            Content="Mini player" FontSize="13" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================ local library ============================ -->
        <Grid x:Name="LibraryPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Local library" Style="{StaticResource Heading}" FontSize="20" />
                    <TextBlock x:Name="LibraryCount" Style="{StaticResource Dim}" Margin="10,3,0,0" Text="0 tracks" />
                </StackPanel>
                <TextBlock x:Name="LibraryStatus" Style="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Divider}" Margin="0,10,0,8" />

            <StackPanel Grid.Row="2" x:Name="LibraryRows" />

            <Grid Grid.Row="3" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal">
                    <controls:HudButton x:Name="FolderButton"
                                        Height="34" CornerRadius="11" Padding="12,0"
                                        HorizontalContentAlignment="Left"
                                        Icon="{StaticResource IconFolder}" IconSize="15" IconMargin="0,0,7,0"
                                        Content="Choose folder" FontSize="13" />
                    <controls:HudButton x:Name="RescanButton"
                                        Height="34" CornerRadius="11" Margin="8,0,0,0" Padding="12,0"
                                        HorizontalContentAlignment="Left"
                                        Icon="{StaticResource IconRefresh}" IconSize="15" IconMargin="0,0,7,0"
                                        Content="Rescan" FontSize="13" />
                </StackPanel>
                <controls:HudButton x:Name="BackButton"
                                    Height="34" CornerRadius="11" Padding="12,0" HorizontalAlignment="Right"
                                    HorizontalContentAlignment="Left"
                                    Icon="{StaticResource IconBack}" IconSize="15" IconMargin="0,0,7,0"
                                    Content="Back" FontSize="13" />
            </Grid>
        </Grid>
    </Grid>
</shared:HudPageBase>
