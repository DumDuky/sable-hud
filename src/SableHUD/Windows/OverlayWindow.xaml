<Window x:Class="SableHUD.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SableHUD.Controls"
        Title="Sable HUD"
        Width="940" Height="404"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Visibility="Hidden"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" Foreground="{DynamicResource Text}">

    <Grid x:Name="Root" Margin="18">
        <Border x:Name="Shell"
                CornerRadius="30"
                Background="{DynamicResource BgGradient}"
                BorderBrush="{DynamicResource Stroke}"
                BorderThickness="1">

            <Grid Margin="22,15,22,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="13" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>

                <!-- ============================ header ============================ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource Accent}">
                            <Path Data="{StaticResource IconChevronDown}"
                                  Fill="{DynamicResource OnAccent}"
                                  Width="12" Height="12"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Sable" FontSize="15" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="HUD" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}" Margin="6,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BgSoft}"
                            BorderBrush="{DynamicResource Stroke}"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="3">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BgSoft}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                CornerRadius="9" Height="26" Padding="9,0" Margin="0,0,9,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="PadDot" Width="5" Height="5" Fill="{DynamicResource TextDim}" VerticalAlignment="Center" />
                                <TextBlock x:Name="PadLabel" Text="No pad" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ClockText" Text="--:--" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <controls:HudButton x:Name="CloseButton"
                                            Width="30" Height="30" CornerRadius="10"
                                            Icon="{StaticResource IconClose}" IconSize="14" IconMargin="0" Padding="0" />
                    </StackPanel>
                </Grid>

                <!-- ============================ widget ============================ -->
                <ContentControl x:Name="PageHost" Grid.Row="2" Focusable="False" />

                <!-- ============================ footer ============================ -->
                <Grid Grid.Row="4">
                    <StackPanel x:Name="HintStrip" Orientation="Horizontal" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,12,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis" MaxWidth="330" />
                        <TextBlock x:Name="HotkeyHint" Text="Ctrl+Alt+H" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="0,0,10,0" />
                        <TextBlock x:Name="VersionText" Text="Sable 1.0" FontSize="11" Foreground="{DynamicResource TextDim}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
