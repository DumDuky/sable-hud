<Window x:Class="SableHUD.Windows.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SableHUD.Controls"
        Title="Sable mini player"
        Width="356" Height="104"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Visibility="Hidden"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True" Foreground="{DynamicResource Text}">

    <Grid x:Name="Root" Margin="12">
        <Border x:Name="Shell"
                CornerRadius="22"
                Background="{DynamicResource BgGradient}"
                BorderBrush="{DynamicResource Stroke}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" />
            </Border.Effect>

            <Grid Margin="10,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource BgSoft}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                    <Grid>
                        <Border CornerRadius="11">
                            <Border.Background>
                                <ImageBrush x:Name="MiniArt" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Grid x:Name="MiniArtFallback">
                            <Grid.Background>
                                <RadialGradientBrush Center="0.3,0.2" GradientOrigin="0.25,0.15">
                                    <GradientStop Color="{DynamicResource ArtTint}" Offset="0" />
                                    <GradientStop Color="{DynamicResource ArtShade}" Offset="1" />
                                </RadialGradientBrush>
                            </Grid.Background>
                            <Path Data="{StaticResource IconMusic}" Fill="{DynamicResource TextDim}" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="MiniTitle" Text="Nothing playing" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MiniArtist" Text="Sable HUD" FontSize="9.8" Foreground="{DynamicResource TextDim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    <controls:HudProgress x:Name="MiniProgress" Height="2.5" Margin="0,6,8,0"
                                          Track="{DynamicResource StrokeStrong}"
                                          Fill="{DynamicResource TextMuted}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <controls:HudButton x:Name="MiniPrev" Width="26" Height="26" CornerRadius="8" Icon="{StaticResource IconPrev}" IconSize="11" IconMargin="0" Padding="0" />
                    <controls:HudButton x:Name="MiniPlay" Width="30" Height="30" CornerRadius="15" Margin="3,0"
                                        Solid="True" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}"
                                        Icon="{StaticResource IconPlay}" IconSize="11" IconMargin="0" Padding="0" />
                    <controls:HudButton x:Name="MiniNext" Width="26" Height="26" CornerRadius="8" Icon="{StaticResource IconNext}" IconSize="11" IconMargin="0" Padding="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
