<Window x:Class="SableHUD.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SableHUD.Controls"
        Title="Sable Settings"
        Width="860" Height="668"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Visibility="Hidden"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True" Foreground="{DynamicResource Text}">

    <Grid x:Name="SettingsRoot" Margin="16">
        <Border x:Name="Shell"
                CornerRadius="26"
                Background="{DynamicResource BgGradient}"
                BorderBrush="{DynamicResource Stroke}"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="46" />
                </Grid.RowDefinitions>

                <Grid x:Name="HeaderBar" Margin="22,0" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource Accent}">
                            <Path Data="{StaticResource IconChevronDown}" Fill="{DynamicResource OnAccent}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Sable" FontSize="13.5" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                        <Border Width="1" Height="14" Background="{DynamicResource Stroke}" Margin="10,0" />
                        <TextBlock x:Name="SectionTitleTop" Text="Settings" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                    </StackPanel>

                    <controls:HudButton x:Name="CloseSettingsButton"
                                        Width="32" Height="32" CornerRadius="10"
                                        HorizontalAlignment="Right"
                                        Icon="{StaticResource IconClose}" IconSize="13" IconMargin="0" Padding="0" />
                </Grid>

                <Grid Grid.Row="1" Margin="22,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="178" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="NavStrip" Margin="0,6,18,0" />

                    <Border Grid.Column="1" Background="{DynamicResource Stroke}" Margin="0,6,0,12" />

                    <ScrollViewer x:Name="SettingsScroll" Grid.Column="2" Margin="22,4,2,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="2,6,22,0">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                        </ScrollViewer.Resources>
                        <StackPanel x:Name="ContentHost" Margin="0,0,0,16" />
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="2" Margin="22,0">
                    <TextBlock Text="Changes save instantly" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionLabel" Style="{StaticResource Dim}" Text="Sable 1.0" Margin="0,0,12,0" />
                        <TextBlock Text="GPL-3.0" Style="{StaticResource Dim}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
