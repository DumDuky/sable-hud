<Window x:Class="SableHUD.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sable now playing"
        Width="430" Height="108"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        Visibility="Hidden"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True" Foreground="{DynamicResource Text}">

    <Grid x:Name="ToastRoot" Margin="12">
        <Border CornerRadius="22"
                Background="{DynamicResource BgGradient}"
                BorderBrush="{DynamicResource Stroke}"
                BorderThickness="1">

            <Grid Margin="10,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="11" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" CornerRadius="13" Background="{DynamicResource BgSoft}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                    <Grid>
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush x:Name="ToastArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border.Background>
                        </Border>
                        <Grid x:Name="ToastArtFallback">
                            <Grid.Background>
                                <RadialGradientBrush Center="0.3,0.2" GradientOrigin="0.25,0.15">
                                    <GradientStop Color="{DynamicResource ArtTint}" Offset="0" />
                                    <GradientStop Color="{DynamicResource ArtShade}" Offset="1" />
                                </RadialGradientBrush>
                            </Grid.Background>
                            <Path Data="{StaticResource IconMusic}" Fill="{DynamicResource TextDim}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ToastLabel" Text="Now playing" Style="{StaticResource Micro}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock x:Name="ToastSource" Text="LiMusic" Style="{StaticResource Micro}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ToastTitle" Text="Track" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ToastArtist" Text="Artist" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    <controls:HudProgress xmlns:controls="clr-namespace:SableHUD.Controls" x:Name="ToastProgress"
                                          Height="2.5" Margin="0,6,10,0"
                                          Track="{DynamicResource StrokeStrong}"
                                          Fill="{DynamicResource TextMuted}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
